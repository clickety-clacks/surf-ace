      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@surf-ace/protocol": "workspace:*",
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
