{
  "name": "@surf-ace/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "legacy-rollback": "node ./dist/legacy-rollback-cli.cjs",
    "launchd:install": "pnpm run build && node ./scripts/install-launch-agent.mjs",
    "launchd:uninstall": "node ./scripts/install-launch-agent.mjs --uninstall",
    "package": "pnpm run build && electron-builder --mac dir --arm64",
    "start": "pnpm run build && electron .",
    "test": "node --test ./dist/test/*.test.js"
  },
  "dependencies": {
    "@surf-ace/protocol": "workspace:*",
    "bonjour-service": "^1.3.0",
    "linkedom": "^0.18.12",
    "pdfjs-dist": "^5.4.296",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "ai.surf-ace.electron",
    "asar": true,
    "directories": {
      "output": "dist/package"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "artifactName": "${productName}.${ext}",
      "category": "public.app-category.developer-tools",
      "entitlements": "build/entitlements.mac.plist",
      "target": [
        {
          "arch": [
            "arm64"
          ],
          "target": "dir"
        }
      ],
      "icon": "build/icon.png"
    },
    "productName": "Surf Ace"
  }
}
